{
  "app-id": "org.frostyard.Frostmail",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node24",
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "frostmail",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-run/frostmail",
    "--filesystem=xdg-cache/frostmail:ro",
    "--filesystem=home:ro"
  ],
  "modules": [
    {
      "name": "frostmail",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/node24/bin",
        "env": {
          "CARGO_HOME": "/run/build/frostmail/cargo",
          "CARGO_NET_OFFLINE": "true",
          "XDG_CACHE_HOME": "/run/build/frostmail/flatpak-node/cache",
          "CI": "true"
        }
      },
      "build-commands": [
        "export PATH=\"$PWD/pnpm-bin:$PATH\" && pnpm install --offline --frozen-lockfile --trust-lockfile",
        "export PATH=\"$PWD/pnpm-bin:$PATH\" && pnpm tauri build",
        "install -Dm755 src-tauri/target/release/frostmail /app/bin/frostmail",
        "install -Dm644 flatpak/org.frostyard.Frostmail.desktop -t /app/share/applications",
        "install -Dm644 flatpak/org.frostyard.Frostmail.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 src-tauri/icons/icon.svg /app/share/icons/hicolor/scalable/apps/org.frostyard.Frostmail.svg",
        "install -Dm644 src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/org.frostyard.Frostmail.png",
        "install -Dm644 src-tauri/icons/icon.png /app/share/icons/hicolor/512x512/apps/org.frostyard.Frostmail.png"
      ],
      "test-commands": [
        "cd src-tauri && if command -v dbus-run-session >/dev/null; then dbus-run-session -- cargo test --release --offline; else env -u DBUS_SESSION_BUS_ADDRESS cargo test --release --offline; fi",
        "desktop-file-validate /app/share/applications/org.frostyard.Frostmail.desktop",
        "appstreamcli validate --no-net /app/share/metainfo/org.frostyard.Frostmail.metainfo.xml",
        "libs=$(ldd /app/bin/frostmail) && ! printf '%s\\n' \"$libs\" | grep 'not found'"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../app",
          "skip": [
            "node_modules",
            "dist",
            "src-tauri/target"
          ]
        },
        {
          "type": "file",
          "path": "org.frostyard.Frostmail.desktop",
          "dest": "flatpak"
        },
        {
          "type": "file",
          "path": "org.frostyard.Frostmail.metainfo.xml",
          "dest": "flatpak"
        },
        {
          "type": "archive",
          "url": "https://registry.npmjs.org/@pnpm/exe.linux-x64/-/exe.linux-x64-12.10.1.tgz",
          "sha512": "641c95d034605b319a0d28d3e5d75104049dc33fabfea3cc621ee8e911a63d08ed4463456d297de316360dc00cf26a82399254503b405d0fb0a415dc7692a592",
          "dest": "pnpm-bin",
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "shell",
          "commands": [
            "sed -i '/^storeDir:/d' pnpm-workspace.yaml"
          ]
        },
        "node-sources.json",
        "cargo-sources.json"
      ]
    }
  ]
}
