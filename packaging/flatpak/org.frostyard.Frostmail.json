{
  "app-id": "org.frostyard.Frostmail",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.golang"
  ],
  "command": "frostmail",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=home:ro"
  ],
  "modules": [
    {
      "name": "frostmail",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/golang/bin",
        "env": {
          "GOPROXY": "file:///run/build/frostmail/goproxy",
          "GOSUMDB": "off",
          "GOTOOLCHAIN": "local",
          "GOFLAGS": "-trimpath -buildvcs=false -modcacherw",
          "GOMODCACHE": "/run/build/frostmail/.gomodcache",
          "GOCACHE": "/run/build/frostmail/.gocache",
          "CGO_ENABLED": "0"
        }
      },
      "build-commands": [
        "go build -tags mygo_noinspector -ldflags '-s -w -X main.version=flatpak -X github.com/egoist/mygo.production=1' -o build/ ./cmd/frostmail ./cmd/maild ./cmd/mailctl",
        "install -Dm755 -t /app/bin build/maild build/mailctl",
        "install -Dm755 build/frostmail /app/libexec/frostmail-app",
        "install -Dm755 packaging/flatpak/frostmail.sh /app/bin/frostmail",
        "install -Dm755 packaging/flatpak/request-background.py /app/libexec/frostmail-request-background",
        "install -Dm755 packaging/flatpak/open.sh /app/libexec/frostmail-open",
        "install -Dm644 packaging/flatpak/org.frostyard.Frostmail.desktop -t /app/share/applications",
        "install -Dm644 packaging/flatpak/org.frostyard.Frostmail.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 packaging/icons/icon.svg /app/share/icons/hicolor/scalable/apps/org.frostyard.Frostmail.svg",
        "install -Dm644 packaging/icons/128x128.png /app/share/icons/hicolor/128x128/apps/org.frostyard.Frostmail.png",
        "install -Dm644 packaging/icons/icon.png /app/share/icons/hicolor/512x512/apps/org.frostyard.Frostmail.png"
      ],
      "test-commands": [
        "/app/bin/maild -version",
        "/app/bin/mailctl --help",
        "desktop-file-validate /app/share/applications/org.frostyard.Frostmail.desktop",
        "appstreamcli validate --no-net /app/share/metainfo/org.frostyard.Frostmail.metainfo.xml",
        "python3 -c \"import ctypes; [ctypes.CDLL(n) for n in ('libgtk-3.so.0', 'libwebkit2gtk-4.1.so.0', 'libjavascriptcoregtk-4.1.so.0', 'libsoup-3.0.so.0')]\"",
        "python3 -m py_compile packaging/flatpak/request-background.py",
        "sh -n packaging/flatpak/open.sh",
        "python3 -c \"from gi.repository import Gio, GLib\"",
        "sh packaging/flatpak/smoke-test.sh"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".github",
            ".flatpak-builder",
            ".worktrees",
            "app",
            "build",
            "dev",
            "docs",
            "flatpak_app",
            "repo"
          ]
        },
        "go-sources.json"
      ]
    }
  ]
}
