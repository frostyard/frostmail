<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.frostyard.Frostmail</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Frostmail</name>
  <summary>Read and send mail</summary>
  <developer id="org.frostyard">
    <name>Frostyard</name>
  </developer>
  <description>
    <p>
      Frostmail is a mail client in the spirit of Apple Mail. It reads and
      sends mail, and it also has a calendar, tasks and contacts.
    </p>
    <p>
      This app carries its own maild, the Frostmail daemon, which syncs
      and stores your mail on this computer. If you choose, it can connect
      to the maild of a lodge server instead.
    </p>
  </description>
  <launchable type="desktop-id">org.frostyard.Frostmail.desktop</launchable>
  <!-- The README's screenshots in docs/images, of the native app on
       made-up mail (docs/design/testing.md, README screenshots), served
       from main of the public repository.
       scripts/flatpak_metainfo_test.go checks them. -->
  <screenshots>
    <screenshot type="default">
      <caption>Mail in three panes: mailboxes, messages and the reader</caption>
      <image>https://raw.githubusercontent.com/frostyard/frostmail/main/docs/images/main.png</image>
    </screenshot>
    <screenshot>
      <caption>The calendar's week, with an event's details</caption>
      <image>https://raw.githubusercontent.com/frostyard/frostmail/main/docs/images/calendar.png</image>
    </screenshot>
    <screenshot>
      <caption>Tasks: lists, subtasks, due dates and the task pane</caption>
      <image>https://raw.githubusercontent.com/frostyard/frostmail/main/docs/images/tasks.png</image>
    </screenshot>
    <screenshot>
      <caption>People: a contact with recent mail and upcoming events</caption>
      <image>https://raw.githubusercontent.com/frostyard/frostmail/main/docs/images/people.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/frostyard/frostmail</url>
  <url type="bugtracker">https://github.com/frostyard/frostmail/issues</url>
  <content_rating type="oars-1.1"/>
