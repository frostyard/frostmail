#!/bin/sh
# Runs the Frostmail app from its local Flatpak (docs/adr/0013). maild
# runs this for notification clicks: frostmail --open-message <id>. Only the
# development bundle (install.sh) installs it; the release Flatpak's launcher
# is packaging/flatpak/frostmail.sh, inside the Flatpak.
exec flatpak run --user org.frostyard.Frostmail "$@"
