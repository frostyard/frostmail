# maild as lodge's mail app (docs/specs/lodge-app.md, ADR-0041): a system
# service as user frostmail, on the socket frostmail.socket passes it.
# mailctl reaches it on the private socket: sudo -u frostmail mailctl ...
[Unit]
Description=Frostmail mail engine (maild) as lodge's mail app
Documentation=https://github.com/frostyard/frostmail/blob/main/docs/specs/lodge-app.md
Requires=frostmail.socket
After=frostmail.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frostmail
Group=frostmail
ExecStart=/usr/local/bin/maild --lodge
Environment=FROSTMAIL_DATA_DIR=/var/lib/frostmail
Environment=FROSTMAIL_CACHE_DIR=/var/cache/frostmail
Environment=FROSTMAIL_SOCKET=/run/frostmail/maild.sock
# The secrets are sealed in /var/lib/frostmail/secrets.sealed (ADR-0044), under
# a key that is a systemd credential. Root makes the key once, with
# scripts/seal-mail-secrets.sh, or by hand:
#   install -d -m 0700 /etc/credstore.encrypted
#   head -c 32 /dev/urandom | systemd-creds encrypt --with-key=auto \
#     --name=frostmail-secrets-key - /etc/credstore.encrypted/frostmail-secrets-key
# Without the key the unit does not start: maild refuses a missing or wrong
# key and never falls back to a plain file. The explicit path of
# LoadCredentialEncrypted= needs systemd 250.
Environment=FROSTMAIL_SECRETS=sealed
LoadCredentialEncrypted=frostmail-secrets-key:/etc/credstore.encrypted/frostmail-secrets-key
StateDirectory=frostmail
StateDirectoryMode=0700
CacheDirectory=frostmail
CacheDirectoryMode=0700
RuntimeDirectory=frostmail
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
