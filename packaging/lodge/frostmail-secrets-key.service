# Makes the key that seals maild's secrets, at first start (ADR-0047).
# frostmail.service pulls it with Requires= and After=. It is never upheld
# and never enabled, so it has no [Install] section: an upheld unit with an
# unmet condition is retried forever. Its condition makes it a clean skip
# when the key exists.
[Unit]
Description=Make the key that seals frostmail's secrets, once
Documentation=https://github.com/frostyard/frostmail/blob/main/docs/adr/0047-make-the-secrets-key-at-first-start.md
ConditionPathExists=!/etc/credstore.encrypted/frostmail-secrets-key
After=tpm2.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/frostmail/make-secrets-key
UMask=0077
# /etc must stay writable, and the TPM device must stay visible, so this is
# neither ProtectSystem=strict nor PrivateDevices=yes.
ProtectSystem=yes
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
